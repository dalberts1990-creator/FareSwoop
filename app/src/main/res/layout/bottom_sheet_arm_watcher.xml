<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Arm FareSwoop Watcher"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSheetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <EditText
        android:id="@+id/etBookedPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Price you booked (£)"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/etCancelDeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Free cancellation deadline" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchSameSupplier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Same supplier only" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbEvery1h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1h (Pro)" />

        <RadioButton
            android:id="@+id/rbEvery3h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="3h (Pro)" />

        <RadioButton
            android:id="@+id/rbEvery6h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="6h (Pro)" />

        <RadioButton
            android:id="@+id/rbEvery12h"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:checked="true"
            android:text="12h (Free)" />
    </RadioGroup>

    <Button
        android:id="@+id/btnActivateWatcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Activate App Price Alert" />
</LinearLayout>
